+    const double d22 = e2[0] * e2[0] + e2[1] * e2[1] + e2[2] * e2[2];
+    const double r1 = r[0] * e1[0] + r[1] * e1[1] + r[2] * e1[2], r2 = r[0] * e2[0] + r[1] * e2[1] + r[2] * e2[2];
+    const double den = d11 * d22 - d12 * d12;
+    if (den > 0.0)
+    {
+      const double u1 = (d22 * r1 - d12 * r2) / den, u2 = (d11 * r2 - d12 * r1) / den;
+      const double u[3] = {1.0 - u1 - u2, u1, u2};
+      double off[3] = {0.0, 0.0, 0.0};
+      for (int i = 0; i < 3; ++i)
+      {
+        const double *ni = &nn[3 * i];
+        const double h = (bq[0] - x[3 * i]) * ni[0] + (bq[1] - x[3 * i + 1]) * ni[1] + (bq[2] - x[3 * i + 2]) * ni[2];
+        for (int c = 0; c < 3; ++c) off[c] -= u[i] * h * ni[c];
