+/* EXPERIMENT (temporary): area-weighted normal of v's fan from current positions. */
+static inline void exp_fan_normal(const MFTL_Object *obj, int v, double n[3])
+{
+  n[0] = n[1] = n[2] = 0.0;
+  const int start = obj->verts.rec[v].out_he_idx;
+  if (start == MFTL_ERROR) return;
+  int h = start, guard = 0;
+  do
+  {
+    const double *p = MFTLVertexPos(obj, v);
+    double d1[3], d2[3];
+    MFTLGetMinimumImageVector(obj->domain, d1, p, MFTLVertexPos(obj, MFTLHeTarget(obj, h)));
+    MFTLGetMinimumImageVector(obj->domain, d2, p, MFTLVertexPos(obj, MFTLHeTarget(obj, MFTLHeNextIdx(h))));
+    n[0] += d1[1] * d2[2] - d1[2] * d2[1];
+    n[1] += d1[2] * d2[0] - d1[0] * d2[2];
+    n[2] += d1[0] * d2[1] - d1[1] * d2[0];
+    h = obj->tris.he[MFTLHePrevIdx(h)].twin_idx;
+  } while (h != MFTL_ERROR && h != start && ++guard < 64);
+  const double l = MFTL_SQRT(n[0] * n[0] + n[1] * n[1] + n[2] * n[2]);
+  if (l > 0.0) n[0] /= l, n[1] /= l, n[2] /= l;
+}
 
+/* EXPERIMENT (temporary): the Phong (alpha = 1/2) point over the midpoint of a-b. */
+static inline void exp_phong_midpoint(const MFTL_Object *obj, int a, int b, double pm[3])
+{
+  double na[3], nb[3];
+  exp_fan_normal(obj, a, na);
+  exp_fan_normal(obj, b, nb);
+  const double *xa = MFTLVertexPos(obj, a);
+  double ab[3];
+  MFTLGetMinimumImageVector(obj->domain, ab, xa, MFTLVertexPos(obj, b));
+  /* m - a = ab/2, m - b = -ab/2 */
+  const double ha = 0.5 * (ab[0] * na[0] + ab[1] * na[1] + ab[2] * na[2]);
+  const double hb = -0.5 * (ab[0] * nb[0] + ab[1] * nb[1] + ab[2] * nb[2]);
+  for (int k = 0; k < 3; ++k) pm[k] = xa[k] + 0.5 * ab[k] - 0.25 * (ha * na[k] + hb * nb[k]);
+  MFTLApplyPeriodicity(obj->domain, pm);
+}
