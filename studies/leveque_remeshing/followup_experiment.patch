+  {
+    /* Phong tessellation, alpha = 1/2: bq + 1/2 SUM u_i (pi_i(bq) - bq). */
+    const double *x = &g_ref.tri[9 * bt];
+    const double *nn = &g_ref.nrm[9 * bt];
+    double e1[3], e2[3], r[3];
+    for (int c = 0; c < 3; ++c) e1[c] = x[3 + c] - x[c], e2[c] = x[6 + c] - x[c], r[c] = bq[c] - x[c];
