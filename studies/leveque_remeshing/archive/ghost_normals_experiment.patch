+/* ── EXPERIMENT: exact ghost normals for the fit (MFTL_EXP_GHOSTNRM) ───────
+ * 1: ghost samples use their OWNER's Max normal (exchanged once per placement,
+ *    kept by global id) for the filter and the slope rows;
+ * 2: ghost samples are dropped altogether. */
+#include <stdlib.h>
+#include "mftl_arrayfunctions.h"
+typedef struct
+{
+  const MFTL_Object *obj;
+  int n;
+  int *gid;
+  int *idx;
+  double *nrm;
+} exp_ghost_table;
+static exp_ghost_table g_exp_tab[256];
+static int g_exp_ntab = 0;
+static int exp_ghost_mode(void)
+{
+  static int m = -1;
+  if (m < 0)
+  {
+    const char *e = getenv("MFTL_EXP_GHOSTNRM");
+    m = e ? atoi(e) : 0;
+  }
+  return m;
+}
+int MFTLRemeshExpGhostMode(void) { return exp_ghost_mode(); }
+
+/* Max normals of every vertex into verts.normal (exact on owned vertices). */
+void MFTLRemeshExpMaxNormals(MFTL_Object *obj)
+{
+  double *nrm = obj->verts.normal;
+  memset(nrm, 0, (size_t) obj->verts.n * 3 * sizeof(double));
+  for (int t = 0; t < obj->tris.n; ++t)
+  {
+    if (obj->tris.rec[t].flags & MFTL_FLAG_DEAD) continue;
+    int tv[3];
+    for (int k = 0; k < 3; ++k) tv[k] = MFTLHeOrigin(obj, 3 * t + k);
+    for (int i = 0; i < 3; ++i)
+    {
+      const double *p = MFTLVertexPos(obj, tv[i]);
+      double e1[3], e2[3], c[3];
+      MFTLGetMinimumImageVector(obj->domain, e1, p, MFTLVertexPos(obj, tv[(i + 1) % 3]));
+      MFTLGetMinimumImageVector(obj->domain, e2, p, MFTLVertexPos(obj, tv[(i + 2) % 3]));
+      MFTLVectorCrossVector(c, e1, e2);
+      const double w = MFTLVectorNormSq(e1) * MFTLVectorNormSq(e2);
+      if (w > 0.0)
+        for (int k = 0; k < 3; ++k) nrm[3 * tv[i] + k] += c[k] / w;
+    }
+  }
+  for (int v = 0; v < obj->verts.n; ++v) MFTLNormalizeVector(&nrm[3 * v]);
+}
+
+/* After the ghost exchange: keep the ghosts' normals by global id. */
+void MFTLRemeshExpStoreGhostNormals(const MFTL_Object *obj)
+{
+  exp_ghost_table *t = MFTL_NULL;
+  for (int i = 0; i < g_exp_ntab; ++i)
+    if (g_exp_tab[i].obj == obj) t = &g_exp_tab[i];
+  if (!t && g_exp_ntab < 256) t = &g_exp_tab[g_exp_ntab++];
+  if (!t) return;
+  free(t->gid);
+  free(t->idx);
+  free(t->nrm);
+  const int ng = obj->verts.n - obj->verts.n_local;
+  t->obj = obj;
+  t->n = ng;
+  t->gid = malloc(sizeof(int) * (size_t) MFTL_MAX(ng, 1));
+  t->idx = malloc(sizeof(int) * (size_t) MFTL_MAX(ng, 1));
+  t->nrm = malloc(sizeof(double) * 3 * (size_t) MFTL_MAX(ng, 1));
+  for (int i = 0; i < ng; ++i)
+  {
+    const int v = obj->verts.n_local + i;
+    t->gid[i] = obj->verts.rec[v].global_id;
+    t->idx[i] = i;
+    for (int k = 0; k < 3; ++k) t->nrm[3 * i + k] = obj->verts.normal[3 * v + k];
+  }
+  MFTLSortPairs32(t->gid, t->idx, ng);
+}
+
+static bool exp_ghost_normal(const MFTL_Object *obj, int v, double n[3])
+{
+  for (int i = 0; i < g_exp_ntab; ++i)
+  {
+    if (g_exp_tab[i].obj != obj) continue;
+    const int j = MFTLSortedIndexOf(g_exp_tab[i].gid, g_exp_tab[i].n, obj->verts.rec[v].global_id);
+    if (j < 0) return MFTL_FALSE;
+    const double *q = &g_exp_tab[i].nrm[3 * g_exp_tab[i].idx[j]];
+    n[0] = q[0], n[1] = q[1], n[2] = q[2];
+    return MFTLVectorNormSq(n) > 0.0;
+  }
+  return MFTL_FALSE;
+}
