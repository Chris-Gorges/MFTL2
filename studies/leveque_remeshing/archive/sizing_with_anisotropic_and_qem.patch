+// -----------------------------------------------------------------------------
+// 10. CURVATURE AND QUADRICS  (see src/geometry/vertex_curvature.c)
+// -----------------------------------------------------------------------------
+
+/**
+ * @brief Discrete mean and Gaussian curvature of every vertex (Meyer, Desbrun,
+ *        Schröder & Barr 2003).
+ *
+ * With \f$A_i\f$ the MIXED area (the Voronoi area where no incident triangle
+ * is obtuse; half or a quarter of an obtuse triangle's area otherwise):
+ * \f[
+ *   H_i = \tfrac12 \Big\lVert \tfrac{1}{2A_i} \sum_j (\cot\alpha_{ij} + \cot\beta_{ij})(\vect{x}_i - \vect{x}_j) \Big\rVert,
+ *   \qquad K_i = \frac{2\pi - \sum_f \theta_f}{A_i},
+ * \f]
+ * so a sphere of radius \f$R\f$ gives \f$H = 1/R\f$ and \f$K = 1/R^2\f$. \f$H\f$
+ * is UNSIGNED. One scatter over all triangles; degenerate faces contribute
+ * nothing and a vertex without area gets zeros. The values are meaningful only
+ * on a closed fan: on the rim of an open surface, and on a ghost vertex of a
+ * distributed mesh (whose fan is partial), they are not curvatures.
+ *
+ * @param      obj             The mesh; needs current `tris.verts`.
+ * @param[out] mean_curvature  `[verts.n]` \f$H_i \ge 0\f$.
+ * @param[out] gauss_curvature `[verts.n]` \f$K_i\f$.
+ * @rank_local
+ */
+void MFTLComputeVertexCurvatures(const MFTL_Object *obj, double *mean_curvature, double *gauss_curvature);
+
+/**
+ * @brief The quadric tensor \f$\mathbf{A}_v = \sum_f A_f\,\hat{\vect{n}}_f\hat{\vect{n}}_f^T\f$
+ *        of every vertex (Heckbert & Garland 1999; Jiao et al. 2010, Sect. 3.3).
+ *
+ * Its eigenvalues \f$\lambda_1 \ge \lambda_2 \ge \lambda_3 \ge 0\f$ carry the
+ * local shape without a curvature estimate: the first eigenvector approximates
+ * the normal, the other two the principal directions, and on a smooth surface
+ * meshed with edges \f$\epsilon_1, \epsilon_2\f$ along them
+ * \f$\lambda_2/\lambda_1 \approx \epsilon_1^2\kappa_1^2/3\f$. One scatter over
+ * all triangles; exact on owned vertices of a distributed mesh, partial on
+ * ghosts.
+ *
+ * @param      obj     The mesh; needs current `tris.verts`.
+ * @param[out] quadric `[6 * verts.n]` packed symmetric tensors (xx, xy, xz, yy, yz, zz).
+ * @rank_local
+ */
+void MFTLComputeVertexQuadrics(const MFTL_Object *obj, double *quadric);
+
+/**
+ * @brief The quadric tensor of one vertex, by walking its fan.
+ *
+ * The same sum as MFTLComputeVertexQuadrics(), for a mesh that is being edited
+ * (a remeshing sweep), where the bulk pass would be out of date one operation
+ * later. Needs valid half-edge records, not `tris.verts`.
+ *
+ * @param      obj     The mesh.
+ * @param      v       Vertex index.
+ * @param[out] quadric Packed symmetric tensor (xx, xy, xz, yy, yz, zz).
+ * @return The number of incident triangles summed (0 for an isolated vertex).
+ * @rank_local
+ */
+int MFTLVertexQuadric(const MFTL_Object *obj, int v, double quadric[6]);
+
+/**
+ * @brief Eigenvalues and eigenvectors of a symmetric 3x3 matrix, by cyclic
+ *        Jacobi rotations.
+ *
+ * Deterministic, and every stopping test is relative, so scaling the matrix by
+ * a power of two scales the eigenvalues by that power and leaves the
+ * eigenvectors unchanged, bit for bit.
+ *
+ * @param      a      Packed symmetric matrix (xx, xy, xz, yy, yz, zz).
+ * @param[out] lambda Eigenvalues, DESCENDING.
+ * @param[out] vec    Unit eigenvectors as rows: `vec[3*i .. 3*i+2]` belongs to `lambda[i]`.
+ * @return The number of sweeps used (at most 50).
+ */
+int MFTLSymmetricEigen3(const double a[6], double lambda[3], double vec[9]);
+
 #endif  // MFTL_GEOMETRY_H
