diff --git a/tests/test_remeshing_sizing.c b/tests/test_remeshing_sizing.c
new file mode 100644
index 0000000..071fdb2
--- /dev/null
+++ b/tests/test_remeshing_sizing.c
@@ -0,0 +1,893 @@
+/**
+ * @file test_remeshing_sizing.c
+ * @brief The two adaptive sizing modes of the remesher -- curvature-adaptive
+ *        (Dunyach et al. 2013) and anisotropic (Jiao et al. 2010) -- and the
+ *        geometry estimators they rest on.
+ *
+ * The references share nothing with the code under test: curvatures of the
+ * sphere and of an ellipsoid are the closed-form ones, the sizing formula is
+ * re-evaluated in the test, and every remeshing result is judged by geometry
+ * the test measures itself (edge lengths by region, triangle orientation,
+ * enclosed volume). The uniform mode is the control in every comparison: a
+ * claim that the adaptive mode concentrates triangles is only a claim if the
+ * uniform mode, on the same input, does not.
+ *
+ * Serial by construction (one rank holds every fixture); the distributed
+ * behaviour is in test_remeshing_sizing_parallel.c.
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <mpi.h>
+
+#include "mftl_core.h"
+#include "mftl_remeshing.h"
+#include "test_mesh_invariants.h"
+#include "test_utils.h"
+
+static MFTL_Ensemble *g_ens = MFTL_NULL;
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ * Fixtures
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+static MFTL_Object *fixture_new(void)
+{
+  MFTL_Object *obj = MFTLObjectCreate(g_ens->n_local_objects);
+  MFTLEnsembleAddObject(g_ens, obj);
+  return obj;
+}
+
+/** @brief The unit icosphere scaled by (sx, sy, sz): an ellipsoid with semi-axes sx, sy, sz. */
+static MFTL_Object *make_ellipsoid(int refinements, double sx, double sy, double sz)
+{
+  MFTL_Object *obj = fixture_new();
+  double center[3] = {0.0, 0.0, 0.0};
+  MFTLGenerateSphere(obj, center, 1.0, refinements);
+  for (int v = 0; v < obj->verts.n; ++v)
+  {
+    double *p = MFTLVertexPosMut(obj, v);
+    p[0] *= sx;
+    p[1] *= sy;
+    p[2] *= sz;
+  }
+  MFTLObjectBuildDerived(obj);
+  MFTLComputeTriangleGeometry(obj, obj->tris.n);
+  return obj;
+}
+
+/**
+ * @brief A flat nx-by-ny grid on [0, wx] x [0, wy], z = 0, each quad cut along
+ *        the same diagonal: every interior vertex has valence six.
+ */
+static MFTL_Object *make_patch(int nx, int ny, double wx, double wy)
+{
+  const int nvx = nx + 1, nvy = ny + 1, nv = nvx * nvy, nt = 2 * nx * ny;
+  double *pos = (double *) malloc((size_t) nv * 3 * sizeof(double));
+  int *tri = (int *) malloc((size_t) nt * 3 * sizeof(int));
+  for (int j = 0; j < nvy; ++j)
+    for (int i = 0; i < nvx; ++i)
+    {
+      const int v = j * nvx + i;
+      pos[3 * v + 0] = wx * (double) i / (double) nx;
+      pos[3 * v + 1] = wy * (double) j / (double) ny;
+      pos[3 * v + 2] = 0.0;
+    }
+  int t = 0;
+  for (int j = 0; j < ny; ++j)
+    for (int i = 0; i < nx; ++i)
+    {
+      const int v00 = j * nvx + i, v10 = v00 + 1, v01 = v00 + nvx, v11 = v01 + 1;
+      tri[3 * t + 0] = v00, tri[3 * t + 1] = v10, tri[3 * t + 2] = v11, ++t;
+      tri[3 * t + 0] = v00, tri[3 * t + 1] = v11, tri[3 * t + 2] = v01, ++t;
+    }
+  MFTL_Object *obj = fixture_new();
+  MFTLBuildIndexedMesh(obj, pos, nv, tri, nt);
+  MFTLComputeTriangleGeometry(obj, obj->tris.n);
+  free(pos);
+  free(tri);
+  return obj;
+}
+
+/**
+ * @brief An open cylinder of radius @p R around the z axis: @p na points round,
+ *        @p nz rings, ring spacing @p dz. Every face normal is perpendicular to
+ *        the axis, exactly.
+ */
+static MFTL_Object *make_cylinder(int na, int nz, double R, double dz)
+{
+  const int nv = na * nz, nt = 2 * na * (nz - 1);
+  double *pos = (double *) malloc((size_t) nv * 3 * sizeof(double));
+  int *tri = (int *) malloc((size_t) nt * 3 * sizeof(int));
+  for (int j = 0; j < nz; ++j)
+    for (int i = 0; i < na; ++i)
+    {
+      const double th = 2.0 * MFTL_PI * (double) i / (double) na;
+      pos[3 * (j * na + i) + 0] = R * cos(th);
+      pos[3 * (j * na + i) + 1] = R * sin(th);
+      pos[3 * (j * na + i) + 2] = dz * (double) j;
+    }
+  int t = 0;
+  for (int j = 0; j + 1 < nz; ++j)
+    for (int i = 0; i < na; ++i)
+    {
+      const int i1 = (i + 1) % na;
+      const int v00 = j * na + i, v10 = j * na + i1, v01 = (j + 1) * na + i, v11 = (j + 1) * na + i1;
+      tri[3 * t + 0] = v00, tri[3 * t + 1] = v10, tri[3 * t + 2] = v11, ++t;
+      tri[3 * t + 0] = v00, tri[3 * t + 1] = v11, tri[3 * t + 2] = v01, ++t;
+    }
+  MFTL_Object *obj = fixture_new();
+  MFTLBuildIndexedMesh(obj, pos, nv, tri, nt);
+  MFTLComputeTriangleGeometry(obj, obj->tris.n);
+  free(pos);
+  free(tri);
+  return obj;
+}
+
+/** @brief The half-edge from vertex @p a to vertex @p b, or MFTL_ERROR. */
+static int find_he(const MFTL_Object *obj, int a, int b)
+{
+  for (int h = 0; h < 3 * obj->tris.n; ++h)
+    if (MFTLHeOrigin(obj, h) == a && MFTLHeTarget(obj, h) == b) return h;
+  return MFTL_ERROR;
+}
+
+/** @brief Two triangles (A,B,C), (B,A,D) in the plane z = 0; returns the half-edge A->B. */
+static int make_pair(MFTL_Object **out, const double A[2], const double B[2], const double C[2], const double D[2])
+{
+  const double pos[12] = {A[0], A[1], 0.0, B[0], B[1], 0.0, C[0], C[1], 0.0, D[0], D[1], 0.0};
+  const int tri[6] = {0, 1, 2, 1, 0, 3};
+  MFTL_Object *obj = fixture_new();
+  MFTLBuildIndexedMesh(obj, pos, 4, tri, 2);
+  MFTLComputeTriangleGeometry(obj, obj->tris.n);
+  *out = obj;
+  return find_he(obj, 0, 1);
+}
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ * Measurements
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+/** @brief Closed-form mean curvature and maximum absolute curvature of x^2/a^2 + y^2/b^2 + z^2/c^2 = 1 at @p p. */
+static void ellipsoid_curvature(const double p[3], double a, double b, double c, double *H, double *K)
+{
+  const double g = p[0] * p[0] / (a * a * a * a) + p[1] * p[1] / (b * b * b * b) + p[2] * p[2] / (c * c * c * c);
+  const double abc2 = a * a * b * b * c * c;
+  *K = 1.0 / (abc2 * g * g);
+  *H = fabs(p[0] * p[0] + p[1] * p[1] + p[2] * p[2] - a * a - b * b - c * c) / (2.0 * abc2 * pow(g, 1.5));
+}
+
+/** @brief Mean length of the undirected edges whose midpoint has |x| in [lo, hi). */
+static double mean_edge_in_band(const MFTL_Object *obj, double lo, double hi, int *count)
+{
+  double sum = 0.0;
+  int n = 0;
+  for (int h = 0; h < 3 * obj->tris.n; ++h)
+  {
+    const int tw = obj->tris.he[h].twin_idx;
+    if (tw != MFTL_ERROR && h > tw) continue;
+    const double *a = MFTLVertexPos(obj, MFTLHeOrigin(obj, h));
+    const double *b = MFTLVertexPos(obj, MFTLHeTarget(obj, h));
+    const double x = fabs(0.5 * (a[0] + b[0]));
+    if (x < lo || x >= hi) continue;
+    sum += MFTLGetEdgeLength(obj, h);
+    n++;
+  }
+  if (count) *count = n;
+  return (n > 0) ? sum / (double) n : 0.0;
+}
+
+/** @brief Triangles whose normal points towards the origin (inverted on a convex body). */
+static int count_inverted(const MFTL_Object *obj)
+{
+  int bad = 0;
+  for (int t = 0; t < obj->tris.n; ++t)
+  {
+    double n[3], c[3];
+    MFTLGetTriangleProperties(obj, t, MFTL_NULL, n, c);
+    if (n[0] * c[0] + n[1] * c[1] + n[2] * c[2] <= 0.0) bad++;
+  }
+  return bad;
+}
+
+/** @brief Enclosed volume by the divergence theorem. */
+static double enclosed_volume(const MFTL_Object *obj)
+{
+  double vol = 0.0;
+  for (int t = 0; t < obj->tris.n; ++t)
+  {
+    int v[3];
+    MFTLGetTriangleVertices(obj, t, v);
+    const double *a = MFTLVertexPos(obj, v[0]), *b = MFTLVertexPos(obj, v[1]), *c = MFTLVertexPos(obj, v[2]);
+    vol += a[0] * (b[1] * c[2] - b[2] * c[1]) - a[1] * (b[0] * c[2] - b[2] * c[0]) + a[2] * (b[0] * c[1] - b[1] * c[0]);
+  }
+  return vol / 6.0;
+}
+
+/**
+ * @brief Mean |cos| between each triangle's LONGEST edge and the x axis, over
+ *        triangles with |centroid x| < @p xmax, and their mean aspect ratio
+ *        (longest edge over the height on it).
+ */
+static double longest_edge_alignment(const MFTL_Object *obj, double xmax, double *aspect)
+{
+  double sum = 0.0, asum = 0.0;
+  int n = 0;
+  for (int t = 0; t < obj->tris.n; ++t)
+  {
+    int v[3];
+    MFTLGetTriangleVertices(obj, t, v);
+    const double *p[3] = {MFTLVertexPos(obj, v[0]), MFTLVertexPos(obj, v[1]), MFTLVertexPos(obj, v[2])};
+    if (fabs((p[0][0] + p[1][0] + p[2][0]) / 3.0) >= xmax) continue;
+    double best = -1.0, e_best[3] = {0, 0, 0};
+    for (int k = 0; k < 3; ++k)
+    {
+      const double e[3] = {p[(k + 1) % 3][0] - p[k][0], p[(k + 1) % 3][1] - p[k][1], p[(k + 1) % 3][2] - p[k][2]};
+      const double l2 = e[0] * e[0] + e[1] * e[1] + e[2] * e[2];
+      if (l2 > best)
+      {
+        best = l2;
+        e_best[0] = e[0], e_best[1] = e[1], e_best[2] = e[2];
+      }
+    }
+    const double area = MFTLGetTriangleArea(obj, t);
+    sum += fabs(e_best[0]) / sqrt(best);
+    asum += best / (2.0 * area);  // longest / (2 A / longest)
+    n++;
+  }
+  if (aspect) *aspect = (n > 0) ? asum / (double) n : 0.0;
+  return (n > 0) ? sum / (double) n : 0.0;
+}
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ * 1. ESTIMATORS
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+static int test_curvature_of_a_sphere(void)
+{
+  double prev = 1.0;
+  for (int r = 2; r <= 4; ++r)
+  {
+    MFTL_Object *obj = make_ellipsoid(r, 2.0, 2.0, 2.0);
+    const int n = obj->verts.n;
+    double *H = malloc((size_t) n * sizeof(double)), *K = malloc((size_t) n * sizeof(double));
+    MFTLComputeVertexCurvatures(obj, H, K);
+    double eh = 0.0, ek = 0.0;
+    for (int v = 0; v < n; ++v)
+    {
+      eh = fmax(eh, fabs(H[v] - 0.5) / 0.5);
+      ek = fmax(ek, fabs(K[v] - 0.25) / 0.25);
+    }
+    printf("\n    refine %d: max rel error H %.2e, K %.2e", r, eh, ek);
+    TEST_ASSERT(eh < prev);  // converges
+    prev = eh;
+    if (r == 4) TEST_ASSERT(eh < 0.02 && ek < 0.05);
+    free(H);
+    free(K);
+  }
+  return 0;
+}
+
+static int test_curvature_of_an_ellipsoid(void)
+{
+  const double a = 1.0, b = 0.5, c = 0.5;
+  double prev = 1.0;
+  for (int r = 3; r <= 5; ++r)
+  {
+    MFTL_Object *obj = make_ellipsoid(r, a, b, c);
+    const int n = obj->verts.n;
+    double *H = malloc((size_t) n * sizeof(double)), *K = malloc((size_t) n * sizeof(double));
+    MFTLComputeVertexCurvatures(obj, H, K);
+    double err = 0.0;
+    for (int v = 0; v < n; ++v)
+    {
+      double He, Ke;
+      ellipsoid_curvature(MFTLVertexPos(obj, v), a, b, c, &He, &Ke);
+      const double km = H[v] + sqrt(fmax(H[v] * H[v] - K[v], 0.0));
+      const double ke = He + sqrt(fmax(He * He - Ke, 0.0));
+      err += (km - ke) * (km - ke) / (ke * ke);
+    }
+    err = sqrt(err / n);
+    printf("\n    refine %d: rms rel error of kappa_max %.2e", r, err);
+    TEST_ASSERT(err < prev);
+    prev = err;
+    free(H);
+    free(K);
+  }
+  TEST_ASSERT(prev < 0.05);
+  return 0;
+}
+
+static int test_the_eigensolver(void)
+{
+  unsigned seed = 1234567u;
+  for (int trial = 0; trial < 200; ++trial)
+  {
+    double A[6];
+    for (int k = 0; k < 6; ++k)
+    {
+      seed = seed * 1103515245u + 12345u;
+      A[k] = ((double) ((seed >> 8) & 0xffff) / 65535.0 - 0.5) * 4.0;
+    }
+    double lam[3], vec[9];
+    MFTLSymmetricEigen3(A, lam, vec);
+    TEST_ASSERT(lam[0] >= lam[1] && lam[1] >= lam[2]);
+    const double M[3][3] = {{A[0], A[1], A[2]}, {A[1], A[3], A[4]}, {A[2], A[4], A[5]}};
+    for (int i = 0; i < 3; ++i)
+    {
+      for (int r = 0; r < 3; ++r)
+      {
+        const double mv = M[r][0] * vec[3 * i + 0] + M[r][1] * vec[3 * i + 1] + M[r][2] * vec[3 * i + 2];
+        TEST_ASSERT(fabs(mv - lam[i] * vec[3 * i + r]) < 1e-12);
+      }
+      for (int j = 0; j < 3; ++j)
+      {
+        const double d = vec[3 * i] * vec[3 * j] + vec[3 * i + 1] * vec[3 * j + 1] + vec[3 * i + 2] * vec[3 * j + 2];
+        TEST_ASSERT(fabs(d - (i == j ? 1.0 : 0.0)) < 1e-12);
+      }
+    }
+    /* Scaling by a power of two is exact. */
+    double As[6], ls[3], vs[9];
+    for (int k = 0; k < 6; ++k) As[k] = ldexp(A[k], -40);
+    MFTLSymmetricEigen3(As, ls, vs);
+    for (int i = 0; i < 3; ++i) TEST_ASSERT(ls[i] == ldexp(lam[i], -40));
+    for (int i = 0; i < 9; ++i) TEST_ASSERT(vs[i] == vec[i]);
+  }
+  return 0;
+}
+
+static int test_the_quadric_of_a_cylinder(void)
+{
+  const int na = 24;
+  MFTL_Object *obj = make_cylinder(na, 8, 1.0, 0.3);
+  MFTLObjectBuildDerived(obj);
+  double *Q = malloc(6 * (size_t) obj->verts.n * sizeof(double));
+  MFTLComputeVertexQuadrics(obj, Q);
+
+  const int v = 3 * na + 5;  // an interior ring
+  double q1[6];
+  MFTLVertexQuadric(obj, v, q1);
+  for (int k = 0; k < 6; ++k) TEST_ASSERT(fabs(q1[k] - Q[6 * v + k]) <= 1e-14 * (fabs(Q[6 * v]) + fabs(Q[6 * v + 3]) + fabs(Q[6 * v + 5])));
+
+  double lam[3], E[9];
+  MFTLSymmetricEigen3(&Q[6 * v], lam, E);
+  const double *p = MFTLVertexPos(obj, v);
+  const double r = sqrt(p[0] * p[0] + p[1] * p[1]);
+  printf("\n    lambda2/lambda1 %.4e  tan^2(dtheta/2) %.4e  lambda3/lambda1 %.1e", lam[1] / lam[0], pow(tan(MFTL_PI / na), 2), lam[2] / lam[0]);
+  TEST_ASSERT(fabs(E[0] * p[0] / r + E[1] * p[1] / r) > 0.999);  // e1: radial
+  TEST_ASSERT(fabs(E[8]) > 0.999);  // e3: axial, the flat direction
+  TEST_ASSERT(lam[2] / lam[0] < 1e-12);
+  const double ratio = (lam[1] / lam[0]) / pow(tan(MFTL_PI / na), 2);
+  TEST_ASSERT(ratio > 0.5 && ratio < 2.0);
+
+  /* The metric: maximal stretch where the curvature is one-sided. */
+  MFTL_RemeshParameters prm;
+  MFTLInitRemeshParams(&prm, MFTL_REMESH_ISOTROPIC, 0.3, 1, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+  double sigma[2], frame[9];
+  MFTLRemeshAnisotropicMetric(&Q[6 * v], &prm.anisotropy, sigma, frame);
+  TEST_ASSERT(sigma[0] >= sigma[1]);
+  TEST_ASSERT(sigma[1] == sqrt(prm.anisotropy.psi_lower));
+  free(Q);
+  return 0;
+}
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ * 2. CURVATURE SIZING
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+static MFTL_RemeshParameters curvature_params(double eps, double lmin, double lmax, int iterations)
+{
+  MFTL_RemeshParameters p;
+  MFTLInitRemeshParams(&p, MFTL_REMESH_ISOTROPIC, lmax, iterations, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+  MFTLRemeshUseCurvatureSizing(&p, eps, lmin, lmax);
+  return p;
+}
+
+static int test_the_sizing_formula(void)
+{
+  const MFTL_RemeshParameters p = curvature_params(0.01, 0.02, 0.4, 1);
+  TEST_ASSERT(MFTLRemeshCurvatureSizing(0.0, &p) == 0.4);
+  TEST_ASSERT(MFTLRemeshCurvatureSizing(-3.0, &p) == 0.4);
+  TEST_ASSERT(MFTLRemeshCurvatureSizing(NAN, &p) == 0.4);
+  TEST_ASSERT(MFTLRemeshCurvatureSizing(2.0 / 0.01, &p) == 0.02);  // the formula's L^2 is zero here
+  TEST_ASSERT(MFTLRemeshCurvatureSizing(1e30, &p) == 0.02);
+  TEST_ASSERT(MFTLRemeshCurvatureSizing(INFINITY, &p) == 0.02);
+
+  double prev = 1e9;
+  for (double k = 0.01; k < 1e4; k *= 1.3)
+  {
+    const double L = MFTLRemeshCurvatureSizing(k, &p);
+    TEST_ASSERT(L == L && L >= 0.02 && L <= 0.4 && L <= prev);
+    prev = L;
+    const double ref = sqrt(6.0 * 0.01 / k - 3.0 * 0.01 * 0.01);
+    if (ref > 0.02 * 1.000001 && ref < 0.4 * 0.999999) TEST_ASSERT(fabs(L - ref) <= 1e-14 * ref);
+  }
+  return 0;
+}
+
+static int test_a_sphere_is_sized_uniformly(void)
+{
+  MFTL_Object *obj = make_ellipsoid(4, 1.0, 1.0, 1.0);
+  const MFTL_RemeshParameters p = curvature_params(0.002, 0.01, 0.5, 1);
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshPrepareSizing(obj, &p));
+  TEST_ASSERT(obj->verts.has_sizing && MFTLObjectPoolsAreConsistent(obj));
+  const double L = MFTLRemeshCurvatureSizing(1.0, &p);
+  double worst = 0.0;
+  for (int v = 0; v < obj->verts.n; ++v) worst = fmax(worst, fabs(obj->verts.sizing[v] - L) / L);
+  printf("\n    L(1/R) = %.5f, worst deviation %.2e", L, worst);
+  TEST_ASSERT(worst < 0.02);
+  return 0;
+}
+
+static int test_an_open_flat_patch_is_sized_at_the_coarsest(void)
+{
+  MFTL_Object *obj = make_patch(6, 6, 1.0, 1.0);
+  const MFTL_RemeshParameters p = curvature_params(0.002, 0.01, 0.3, 1);
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshPrepareSizing(obj, &p));
+  /* Interior: no curvature. Rim: the mean of its interior neighbours, not the
+   * half-fan's meaningless "curvature". */
+  for (int v = 0; v < obj->verts.n; ++v) TEST_ASSERT(obj->verts.sizing[v] == 0.3);
+  return 0;
+}
+
+static int test_an_invalid_block_is_refused(void)
+{
+  MFTL_Object *obj = make_ellipsoid(1, 1.0, 1.0, 1.0);
+  MFTL_RemeshParameters p = curvature_params(0.0, 0.01, 0.5, 1);
+  TEST_ASSERT_EQUAL_INT(MFTL_ERROR, MFTLRemeshPrepareSizing(obj, &p));
+  TEST_ASSERT_EQUAL_INT(MFTL_ERROR, MFTLRemeshObject(obj, &p, MFTL_NULL));
+  p = curvature_params(0.01, 0.6, 0.5, 1);  // L_min > L_max
+  TEST_ASSERT_EQUAL_INT(MFTL_ERROR, MFTLRemeshPrepareSizing(obj, &p));
+  p = curvature_params(0.01, 0.1, 0.5, 1);
+  p.smooth_mode = MFTL_SMOOTH_VERTEX_BASED;
+  TEST_ASSERT_EQUAL_INT(MFTL_ERROR, MFTLRemeshPrepareSizing(obj, &p));
+  return 0;
+}
+
+/**
+ * @brief The sign of the smoother's density: on a flat grid with targets
+ *        growing in x, the interior vertices move towards SMALL x, where the
+ *        mesh is to be finer. The printed Eq. 6 of Dunyach et al. (weight
+ *        |t| L) would move them the other way; uniform weights do not move a
+ *        regular grid at all.
+ */
+static int test_the_smoother_moves_towards_the_fine_side(void)
+{
+  MFTL_Object *obj = make_patch(8, 8, 1.0, 1.0);
+  MFTLObjectBuildDerived(obj);
+  MFTLDetectFeatures(obj, 180.0, 45.0, MFTL_NULL);
+  MFTLObjectEnableSizing(obj);
+  for (int v = 0; v < obj->verts.n; ++v) obj->verts.sizing[v] = 0.05 + 0.5 * MFTLVertexPos(obj, v)[0];
+
+  double *before = malloc(3 * (size_t) obj->verts.n * sizeof(double));
+  memcpy(before, obj->verts.pos, 3 * (size_t) obj->verts.n * sizeof(double));
+
+  MFTL_RemeshParameters u;
+  MFTLInitRemeshParams(&u, MFTL_REMESH_ISOTROPIC, 0.125, 1, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+  MFTLSmoothTangential(obj, &u, 1);
+  double moved = 0.0;
+  for (int i = 0; i < 3 * obj->verts.n; ++i) moved = fmax(moved, fabs(obj->verts.pos[i] - before[i]));
+  TEST_ASSERT(moved < 1e-12);
+
+  const MFTL_RemeshParameters p = curvature_params(0.01, 0.01, 1.0, 1);
+  MFTLSmoothTangential(obj, &p, 1);
+  int n_interior = 0, n_left = 0;
+  for (int v = 0; v < obj->verts.n; ++v)
+  {
+    if (obj->verts.rec[v].flags & (MFTL_FLAG_FEATURE | MFTL_FLAG_CORNER)) continue;
+    n_interior++;
+    if (obj->verts.pos[3 * v] < before[3 * v] - 1e-6) n_left++;
+    TEST_ASSERT(fabs(obj->verts.pos[3 * v + 2]) < 1e-15);  // stays in the plane
+  }
+  TEST_ASSERT(n_interior == 49 && n_left == n_interior);
+  free(before);
+  return 0;
+}
+
+static int test_curvature_mode_on_a_sphere_is_uniform_mode(void)
+{
+  /* L(1/R) is the target both runs aim at. */
+  MFTL_RemeshParameters c = curvature_params(0.004, 0.02, 1.0, 10);
+  const double L = MFTLRemeshCurvatureSizing(1.0, &c);
+  MFTL_RemeshParameters u;
+  MFTLInitRemeshParams(&u, MFTL_REMESH_ISOTROPIC, L, 10, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+
+  MFTL_Object *a = make_ellipsoid(3, 1.0, 1.0, 1.0);
+  MFTL_Object *b = make_ellipsoid(3, 1.0, 1.0, 1.0);
+  MFTL_RemeshStats sa, sb;
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(a, &c, &sa));
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(b, &u, &sb));
+  printf("\n    L = %.4f: curvature %d tris, uniform %d tris", L, a->tris.n, b->tris.n);
+  TEST_ASSERT(fabs((double) a->tris.n - b->tris.n) < 0.1 * b->tris.n);
+  TEST_ASSERT(inv_mesh_is_sound(a, 0) && inv_mesh_is_closed(a));
+  TEST_ASSERT_EQUAL_INT(0, count_inverted(a));
+  return 0;
+}
+
+static int test_curvature_mode_refines_where_curved(void)
+{
+  const double a = 1.0, b = 0.4;
+  /* Tip kappa_max = a / b^2 = 6.25, waist kappa_max = 1 / b = 2.5. */
+  MFTL_RemeshParameters c = curvature_params(0.002, 0.01, 1.0, 12);
+  const double L_tip = MFTLRemeshCurvatureSizing(a / (b * b), &c);
+  const double L_waist = MFTLRemeshCurvatureSizing(1.0 / b, &c);
+  MFTL_RemeshParameters u;
+  MFTLInitRemeshParams(&u, MFTL_REMESH_ISOTROPIC, sqrt(L_tip * L_waist), 12, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+
+  MFTL_Object *adapt = make_ellipsoid(3, a, b, b);
+  MFTL_Object *unif = make_ellipsoid(3, a, b, b);
+  const double v0 = enclosed_volume(adapt);
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(adapt, &c, MFTL_NULL));
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(unif, &u, MFTL_NULL));
+
+  int nt, nw;
+  const double ta = mean_edge_in_band(adapt, 0.85, 2.0, &nt), wa = mean_edge_in_band(adapt, 0.0, 0.2, &nw);
+  const double tu = mean_edge_in_band(unif, 0.85, 2.0, MFTL_NULL), wu = mean_edge_in_band(unif, 0.0, 0.2, MFTL_NULL);
+  printf("\n    predicted tip/waist %.3f; curvature %.3f (%.4f/%.4f, %d/%d edges); uniform %.3f; %d vs %d tris; dV %.2e", L_tip / L_waist, ta / wa, ta, wa,
+         nt, nw, tu / wu, adapt->tris.n, unif->tris.n, enclosed_volume(adapt) / v0 - 1.0);
+  TEST_ASSERT(ta / wa < 0.8 * (tu / wu));
+  TEST_ASSERT(fabs(ta / wa - L_tip / L_waist) < 0.2 * L_tip / L_waist);
+  TEST_ASSERT(inv_mesh_is_sound(adapt, 0) && inv_mesh_is_closed(adapt));
+  TEST_ASSERT_EQUAL_INT(0, count_inverted(adapt));
+  return 0;
+}
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ * 3. ANISOTROPIC SIZING
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+static MFTL_RemeshParameters aniso_params(double l, int iterations)
+{
+  MFTL_RemeshParameters p;
+  MFTLInitRemeshParams(&p, MFTL_REMESH_ISOTROPIC, l, iterations, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+  MFTLRemeshUseAnisotropicSizing(&p, l);
+  return p;
+}
+
+static int test_jiao_split_criteria(void)
+{
+  const MFTL_RemeshParameters p = aniso_params(1.0, 1);  // l = 1, L = 1.5, s = 0.267
+  MFTL_Object *o;
+  int h;
+
+  /* Absolute longness: longer than L and the longest edge of its triangles. */
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {2, 0}, (double[]) {1, 1}, (double[]) {1, -1});
+  TEST_ASSERT(MFTLRemeshEdgeWantsSplit(o, h, &p));
+
+  /* Longer than L but NOT the longest (AD is longer), and opposite a 157
+   * degree angle: relative longness must still be tried -- the two criteria are
+   * alternatives. */
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {2, 0}, (double[]) {1, 0.2}, (double[]) {1, -3});
+  TEST_ASSERT(MFTLRemeshEdgeWantsSplit(o, h, &p));
+
+  /* The same without the flat angle: neither criterion. */
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {2, 0}, (double[]) {1, 1.2}, (double[]) {1, -3});
+  TEST_ASSERT(!MFTLRemeshEdgeWantsSplit(o, h, &p));
+
+  /* Relative longness, but an incident edge shorter than s: over-refinement guard. */
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {1.2, 0}, (double[]) {0.1, 0.03}, (double[]) {0.6, -1});
+  TEST_ASSERT(!MFTLRemeshEdgeWantsSplit(o, h, &p));
+  /* ... and with the short edge removed, wanted. */
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {1.2, 0}, (double[]) {0.6, 0.12}, (double[]) {0.6, -1});
+  TEST_ASSERT(MFTLRemeshEdgeWantsSplit(o, h, &p));
+  return 0;
+}
+
+static int test_jiao_collapse_criteria(void)
+{
+  const MFTL_RemeshParameters p = aniso_params(1.0, 1);  // r = 0.25, R = 0.45, S = 0.45, theta_s = 15
+  MFTL_Object *o;
+  int h;
+
+  /* Relative shortness only (the triangles are larger than l). */
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {0.3, 0}, (double[]) {0.15, 2}, (double[]) {0.15, -2});
+  TEST_ASSERT(MFTLRemeshEdgeWantsCollapse(o, h, &p));
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {0.6, 0}, (double[]) {0.3, 2}, (double[]) {0.3, -2});
+  TEST_ASSERT(!MFTLRemeshEdgeWantsCollapse(o, h, &p));
+
+  /* Absolute small triangle: everything under S, and the shortest edge. */
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {0.2, 0}, (double[]) {0.1, 0.25}, (double[]) {0.1, -0.25});
+  TEST_ASSERT(MFTLRemeshEdgeWantsCollapse(o, h, &p));
+  /* ... not the shortest: no. */
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {0.3, 0}, (double[]) {0.15, 0.1}, (double[]) {0.15, -0.1});
+  TEST_ASSERT(!MFTLRemeshEdgeWantsCollapse(o, h, &p));
+
+  /* Relative small triangle: under l, and under R times the longest edge. */
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {0.3, 0}, (double[]) {0.15, 0.7}, (double[]) {0.15, -0.7});
+  TEST_ASSERT(MFTLRemeshEdgeWantsCollapse(o, h, &p));
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {0.35, 0}, (double[]) {0.175, 0.7}, (double[]) {0.175, -0.7});
+  TEST_ASSERT(!MFTLRemeshEdgeWantsCollapse(o, h, &p));
+
+  /* Absolute small angle: under theta_s in a triangle smaller than l. */
+  h = make_pair(&o, (double[]) {0, 0}, (double[]) {0.12, 0}, (double[]) {0.06, 0.5}, (double[]) {0.06, -0.5});
+  TEST_ASSERT(MFTLRemeshEdgeWantsCollapse(o, h, &p));
+  return 0;
+}
+
+/**
+ * @brief On a plane the metric is isotropic, so the anisotropic flip must be the
+ *        Delaunay flip -- and the valence flip of the uniform mode must not
+ *        agree with it on a regular grid.
+ */
+static int test_jiao_flip_is_delaunay_on_a_plane(void)
+{
+  MFTL_Object *obj = make_patch(4, 4, 1.0, 1.0);
+  MFTLObjectBuildDerived(obj);
+  const int nvx = 5;
+  const int a = 1 * nvx + 1, b = 2 * nvx + 2;  // an interior diagonal (v00 -> v11)
+  int h = find_he(obj, a, b);
+  TEST_ASSERT(h != MFTL_ERROR);
+  if (obj->tris.he[h].twin_idx < h) h = obj->tris.he[h].twin_idx;  // the canonical half is the one offered
+
+  const MFTL_RemeshParameters p = aniso_params(0.25, 1);
+  MFTL_RemeshParameters u;
+  MFTLInitRemeshParams(&u, MFTL_REMESH_ISOTROPIC, 0.25, 1, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+
+  /* Every quad is a square: its two diagonals are cocircular, no flip. */
+  TEST_ASSERT(!MFTLFlipApproved(obj, h, &p, MFTL_NULL));
+
+  /* Pull one apex towards the diagonal: the angle there exceeds 90 degrees and
+   * the quad is no longer Delaunay. */
+  const int c = MFTLHeTarget(obj, MFTLHeNextIdx(h));
+  double *pc = MFTLVertexPosMut(obj, c);
+  const double *pa = MFTLVertexPos(obj, a), *pb = MFTLVertexPos(obj, b);
+  for (int k = 0; k < 2; ++k) pc[k] += 0.3 * (0.5 * (pa[k] + pb[k]) - pc[k]);
+  TEST_ASSERT(MFTLFlipApproved(obj, h, &p, MFTL_NULL));
+  TEST_ASSERT(!MFTLFlipApproved(obj, h, &u, MFTL_NULL));  // valences 6/6/6/6: the uniform mode keeps it
+  return 0;
+}
+
+static int test_anisotropic_mode_stretches_along_the_flat_direction(void)
+{
+  /* An elongated ellipsoid: at the waist the curvature round is 1/b = 4 and
+   * along the axis b/a^2 = 0.25. Both meshes are first made ISOTROPIC by a
+   * uniform remesh -- the scaled icosphere is stretched along the axis already
+   * and would show nothing -- and then continue, one uniform (the control), one
+   * anisotropic. */
+  const double a = 1.0, b = 0.25;
+  const double l = 0.06;
+  MFTL_RemeshParameters p = aniso_params(l, 20);
+  MFTL_RemeshParameters u;
+  MFTLInitRemeshParams(&u, MFTL_REMESH_ISOTROPIC, l, 20, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+
+  MFTL_Object *an = make_ellipsoid(4, a, b, b);
+  MFTL_Object *un = make_ellipsoid(4, a, b, b);
+  for (int pass = 0; pass < 2; ++pass)
+  {
+    TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(an, &u, MFTL_NULL));
+    TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(un, &u, MFTL_NULL));
+  }
+  double asp0;
+  const double al0 = longest_edge_alignment(an, 0.5, &asp0);
+
+  const double v0 = enclosed_volume(an);
+  MFTL_RemeshStats sa;
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(an, &p, &sa));
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(un, &u, MFTL_NULL));
+
+  double asp_a, asp_u;
+  const double al_a = longest_edge_alignment(an, 0.5, &asp_a);
+  const double al_u = longest_edge_alignment(un, 0.5, &asp_u);
+  printf("\n    waist |cos(longest, axis)| / aspect: start %.3f / %.2f; anisotropic %.3f / %.2f; uniform %.3f / %.2f; %d vs %d tris; ops %d/%d/%d; "
+         "dV %.2e (uniform %.2e)",
+         al0, asp0, al_a, asp_a, al_u, asp_u, an->tris.n, un->tris.n, sa.n_split, sa.n_collapse, sa.n_flip, enclosed_volume(an) / v0 - 1.0,
+         enclosed_volume(un) / v0 - 1.0);
+  /* Measured 0.930 / 1.60 against 0.857 / 1.38. The metric asks for about
+   * sqrt((l^2 / 3b^2) / psi_l) = 1.96 : 1 at the waist and reaches it only
+   * progressively (Jiao et al., Sect. 3.3), so the claim is a clear move away
+   * from the control, not the target. */
+  TEST_ASSERT(al_a > al_u + 0.05);
+  TEST_ASSERT(asp_a > 1.1 * asp_u);
+  TEST_ASSERT(inv_mesh_is_sound(an, 0) && inv_mesh_is_closed(an));
+  TEST_ASSERT_EQUAL_INT(0, count_inverted(an));
+  return 0;
+}
+
+/** @brief LeVeque's 3D deformation field (period @p T), the one examples/leveque_remeshing_*.c advect by. */
+static void leveque_velocity(const double x[3], double t, double T, double u[3])
+{
+  const double s = cos(MFTL_PI * t / T);
+  u[0] = 2.0 * sin(MFTL_PI * x[0]) * sin(MFTL_PI * x[0]) * sin(2.0 * MFTL_PI * x[1]) * sin(2.0 * MFTL_PI * x[2]) * s;
+  u[1] = -sin(MFTL_PI * x[1]) * sin(MFTL_PI * x[1]) * sin(2.0 * MFTL_PI * x[0]) * sin(2.0 * MFTL_PI * x[2]) * s;
+  u[2] = -sin(MFTL_PI * x[2]) * sin(MFTL_PI * x[2]) * sin(2.0 * MFTL_PI * x[0]) * sin(2.0 * MFTL_PI * x[1]) * s;
+}
+
+/**
+ * @brief Advected and remeshed every step, the anisotropic mode holds the
+ *        enclosed volume.
+ *
+ * The smoother maps each face's centroid offset by the face metric; normalised
+ * by sqrt(sigma2 sigma3) that mapping had a gain of up to 1.93 across the
+ * curved direction -- an overshoot exactly where a tangential move leaves the
+ * surface -- and the LeVeque period lost 39 % of its volume. A STATIC body does
+ * not show it (the smoother settles and the overshoot goes to zero), and no
+ * single pass does: it needs a mesh kept off equilibrium, which is what
+ * advection is. Mutation-checked: with the old normalisation this run loses
+ * 10.2 %, five times the bound.
+ */
+static int test_an_advected_anisotropic_mesh_holds_its_volume(void)
+{
+  MFTL_Object *obj = fixture_new();
+  double centre[3] = {0.35, 0.35, 0.35};
+  MFTLGenerateSphere(obj, centre, 0.15, 3);
+  MFTLComputeTriangleGeometry(obj, obj->tris.n);
+  MFTL_RemeshParameters p = aniso_params(MFTLMeanEdgeLength(obj), 3);
+  p.smooth_iterations = 3;
+  const double v0 = enclosed_volume(obj);
+
+  const double T = 3.0, dt = 0.02;
+  double t = 0.0;
+  for (int step = 0; step < 40; ++step, t += dt)
+  {
+    for (int v = 0; v < obj->verts.n; ++v)
+    {
+      double *x = MFTLVertexPosMut(obj, v);
+      double k1[3], k2[3], k3[3], k4[3], y[3];
+      leveque_velocity(x, t, T, k1);
+      for (int k = 0; k < 3; ++k) y[k] = x[k] + 0.5 * dt * k1[k];
+      leveque_velocity(y, t + 0.5 * dt, T, k2);
+      for (int k = 0; k < 3; ++k) y[k] = x[k] + 0.5 * dt * k2[k];
+      leveque_velocity(y, t + 0.5 * dt, T, k3);
+      for (int k = 0; k < 3; ++k) y[k] = x[k] + dt * k3[k];
+      leveque_velocity(y, t + dt, T, k4);
+      for (int k = 0; k < 3; ++k) x[k] += dt / 6.0 * (k1[k] + 2.0 * k2[k] + 2.0 * k3[k] + k4[k]);
+    }
+    MFTLObjectMarkChanged(obj);
+    TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(obj, &p, MFTL_NULL));
+  }
+  const double dv = enclosed_volume(obj) / v0 - 1.0;
+  printf("\n    40 advected steps: dV %.2e, %d tris", dv, obj->tris.n);
+  TEST_ASSERT(fabs(dv) < 0.02);  // +0.83 % measured (Debug); the old normalisation: -10.2 %
+  TEST_ASSERT(inv_mesh_is_sound(obj, 0) && inv_mesh_is_closed(obj));
+  return 0;
+}
+
+static int test_qem_placement_keeps_a_sphere_round(void)
+{
+  /* Splitting at chord midpoints puts every new vertex inside the sphere; the
+   * quadric-error point is (to second order) on it. Refine a coarse sphere and
+   * compare how far the vertices end up from the unit radius. */
+  MFTL_Object *mid = make_ellipsoid(1, 1.0, 1.0, 1.0);
+  MFTL_Object *qem = make_ellipsoid(1, 1.0, 1.0, 1.0);
+  MFTL_RemeshParameters p;
+  MFTLInitRemeshParams(&p, MFTL_REMESH_ISOTROPIC, 0.25, 6, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+  p.smooth_iterations = 0;
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(mid, &p, MFTL_NULL));
+  p.qem_placement = MFTL_TRUE;
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(qem, &p, MFTL_NULL));
+
+  double dm = 0.0, dq = 0.0;
+  for (int v = 0; v < mid->verts.n; ++v)
+  {
+    const double *x = MFTLVertexPos(mid, v);
+    dm += fabs(1.0 - sqrt(x[0] * x[0] + x[1] * x[1] + x[2] * x[2]));
+  }
+  for (int v = 0; v < qem->verts.n; ++v)
+  {
+    const double *x = MFTLVertexPos(qem, v);
+    dq += fabs(1.0 - sqrt(x[0] * x[0] + x[1] * x[1] + x[2] * x[2]));
+  }
+  dm /= mid->verts.n;
+  dq /= qem->verts.n;
+  printf("\n    mean |1 - r|: midpoint %.4f (%d verts), quadric error %.4f (%d verts)", dm, mid->verts.n, dq, qem->verts.n);
+  TEST_ASSERT(dq < 0.8 * dm);
+  TEST_ASSERT(inv_mesh_is_sound(qem, 0) && inv_mesh_is_closed(qem));
+  return 0;
+}
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ * 4. LENGTH UNIT
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+/** @brief Remeshes a scrambled ellipsoid at unit scale and at 2^-20 under @p mode; bit-for-bit equal up to the scale. */
+static int length_unit_case(MFTL_RemeshSizing mode)
+{
+  const double s = ldexp(1.0, -20);
+  MFTL_Object *unit = make_ellipsoid(3, 1.0, 0.6, 0.6);
+  unsigned seed = 24681357u;
+  for (int v = 0; v < unit->verts.n; ++v)
+  {
+    double *q = MFTLVertexPosMut(unit, v);
+    for (int k = 0; k < 3; ++k)
+    {
+      seed = seed * 1103515245u + 12345u;
+      q[k] *= 1.0 + 0.08 * ((double) ((seed >> 16) & 0x7fff) / 32767.0 - 0.5);
+    }
+  }
+  MFTLComputeTriangleGeometry(unit, unit->tris.n);
+
+  int cuts[3] = {1, 1, 1};
+  double lo[3] = {-4.0 * s, -4.0 * s, -4.0 * s}, hi[3] = {4.0 * s, 4.0 * s, 4.0 * s};
+  bool periodic[3] = {MFTL_FALSE, MFTL_FALSE, MFTL_FALSE};
+  MFTL_Ensemble *small_ens = MFTLEnsembleCreate(MPI_COMM_SELF, cuts, lo, hi, periodic, 1);
+  MFTL_Object *small = MFTLObjectCreate(0);
+  MFTLEnsembleAddObject(small_ens, small);
+  double centre[3] = {0.0, 0.0, 0.0};
+  MFTLGenerateSphere(small, centre, s, 3);
+  for (int i = 0; i < 3 * unit->verts.n; ++i) small->verts.pos[i] = unit->verts.pos[i] * s;
+  MFTLComputeTriangleGeometry(small, small->tris.n);
+
+  const double target = MFTLMeanEdgeLength(unit);
+  MFTL_RemeshParameters pu, ps;
+  MFTLInitRemeshParams(&pu, MFTL_REMESH_ISOTROPIC, target, 8, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+  MFTLInitRemeshParams(&ps, MFTL_REMESH_ISOTROPIC, target * s, 8, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+  if (mode == MFTL_REMESH_SIZING_CURVATURE)
+  {
+    MFTLRemeshUseCurvatureSizing(&pu, 0.02 * target, 0.25 * target, 1.5 * target);
+    MFTLRemeshUseCurvatureSizing(&ps, 0.02 * target * s, 0.25 * target * s, 1.5 * target * s);
+  }
+  else
+  {
+    MFTLRemeshUseAnisotropicSizing(&pu, target);
+    MFTLRemeshUseAnisotropicSizing(&ps, target * s);
+  }
+  pu.smooth_iterations = ps.smooth_iterations = 2;
+
+  MFTL_RemeshStats su, ss;
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(unit, &pu, &su));
+  TEST_ASSERT_EQUAL_INT(MFTL_SUCCESS, MFTLRemeshObject(small, &ps, &ss));
+  printf("\n    unit: %d/%d/%d -> %d tris; x2^-20: %d/%d/%d -> %d tris", su.n_split, su.n_collapse, su.n_flip, unit->tris.n, ss.n_split, ss.n_collapse,
+         ss.n_flip, small->tris.n);
+  TEST_ASSERT(su.n_split + su.n_collapse > 0 && su.n_flip > 0);
+  TEST_ASSERT_EQUAL_INT(su.n_split, ss.n_split);
+  TEST_ASSERT_EQUAL_INT(su.n_collapse, ss.n_collapse);
+  TEST_ASSERT_EQUAL_INT(su.n_flip, ss.n_flip);
+  TEST_ASSERT_EQUAL_INT(unit->tris.n, small->tris.n);
+  int same = 1;
+  for (int i = 0; i < 3 * unit->verts.n; ++i) same &= (small->verts.pos[i] == unit->verts.pos[i] * s);
+  TEST_ASSERT(same);
+  MFTLEnsembleDestroy(&small_ens);
+  return 0;
+}
+
+static int test_curvature_mode_is_independent_of_the_length_unit(void) { return length_unit_case(MFTL_REMESH_SIZING_CURVATURE); }
+static int test_anisotropic_mode_is_independent_of_the_length_unit(void) { return length_unit_case(MFTL_REMESH_SIZING_ANISOTROPIC); }
+
+/* ═══════════════════════════════════════════════════════════════════════════ */
+
+int main(int argc, char **argv)
+{
+  MPI_Init(&argc, &argv);
+
+  int cuts[3] = {1, 1, 1};
+  double lo[3] = {-4.0, -4.0, -4.0};
+  double hi[3] = {4.0, 4.0, 4.0};
+  bool periodic[3] = {MFTL_FALSE, MFTL_FALSE, MFTL_FALSE};
+  g_ens = MFTLEnsembleCreate(MPI_COMM_SELF, cuts, lo, hi, periodic, 64);
+  if (!g_ens) MPI_Abort(MPI_COMM_WORLD, 1);
+
+  printf("\n=== 1. Estimators ===\n");
+  RUN_TEST(test_curvature_of_a_sphere);
+  RUN_TEST(test_curvature_of_an_ellipsoid);
+  RUN_TEST(test_the_eigensolver);
+  RUN_TEST(test_the_quadric_of_a_cylinder);
+
+  printf("\n=== 2. Curvature sizing ===\n");
+  RUN_TEST(test_the_sizing_formula);
+  RUN_TEST(test_a_sphere_is_sized_uniformly);
+  RUN_TEST(test_an_open_flat_patch_is_sized_at_the_coarsest);
+  RUN_TEST(test_an_invalid_block_is_refused);
+  RUN_TEST(test_the_smoother_moves_towards_the_fine_side);
+  RUN_TEST(test_curvature_mode_on_a_sphere_is_uniform_mode);
+  RUN_TEST(test_curvature_mode_refines_where_curved);
+
+  printf("\n=== 3. Anisotropic sizing ===\n");
+  RUN_TEST(test_jiao_split_criteria);
+  RUN_TEST(test_jiao_collapse_criteria);
+  RUN_TEST(test_jiao_flip_is_delaunay_on_a_plane);
+  RUN_TEST(test_anisotropic_mode_stretches_along_the_flat_direction);
+  RUN_TEST(test_an_advected_anisotropic_mesh_holds_its_volume);
+  RUN_TEST(test_qem_placement_keeps_a_sphere_round);
+
+  printf("\n=== 4. Length unit ===\n");
+  RUN_TEST(test_curvature_mode_is_independent_of_the_length_unit);
+  RUN_TEST(test_anisotropic_mode_is_independent_of_the_length_unit);
+
+  TEST_REPORT();
+  MFTLEnsembleDestroy(&g_ens);
+  MPI_Finalize();
+  return (g_tests_failed > 0) ? 1 : 0;
+}
diff --git a/tests/test_remeshing_sizing_parallel.c b/tests/test_remeshing_sizing_parallel.c
new file mode 100644
index 0000000..c4e8650
--- /dev/null
+++ b/tests/test_remeshing_sizing_parallel.c
@@ -0,0 +1,495 @@
+/**
+ * @file test_remeshing_sizing_parallel.c
+ * @brief The adaptive sizing modes on a PARTITIONED mesh: the curvature field
+ *        on ghost copies, the spanning driver under both modes, and the two
+ *        distributed strategies as each other's cross-check.
+ *
+ * Every result is compared against something that shares none of the
+ * distribution: the sizing field against the same field computed on one rank
+ * with MPI_COMM_SELF before partitioning (matched by vertex global id), the
+ * distributed pass against MFTLRemeshObject() of the same body on one rank, and
+ * the dispersed driver against the spanning one. Every fixture straddles the
+ * cut planes of every grid the suite runs, and the straddling is MEASURED
+ * (anywhere()): a distributed test whose curved region sits inside one rank
+ * would pass with the ghost exchange deleted.
+ *
+ * Every assertion is made on an agreed() verdict (test_mesh_invariants.h).
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <mpi.h>
+
+#include "mftl_core.h"
+#include "test_mesh_invariants.h"
+#include "test_utils.h"
+
+static int g_rank = 0;
+static int g_nproc = 1;
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ * Fixtures
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+/** @brief [-1,1]^3 on the suite's grid for this rank count. */
+static MFTL_Ensemble *make_ensemble(MPI_Comm comm, bool periodic)
+{
+  int cuts[3] = {1, 1, 1};
+  int np;
+  MPI_Comm_size(comm, &np);
+  test_grid_for(np, cuts);
+  double lo[3] = {-1.0, -1.0, -1.0}, hi[3] = {1.0, 1.0, 1.0};
+  bool per[3] = {periodic, periodic, periodic};
+  return MFTLEnsembleCreate(comm, cuts, lo, hi, per, 2);
+}
+
+/** @brief An icosphere scaled to semi-axes (a, b, c) about (cx, cy, cz); optionally only its upper half (an open cap). */
+static void add_ellipsoid(MFTL_Ensemble *ens, double cx, double cy, double cz, double a, double b, double c, int refine, bool cap)
+{
+  /* Built on rank 0 of @p ens only, like every generator (partition() then
+   * publishes and spreads it), and by the same arithmetic on every rank's
+   * MPI_COMM_SELF reference -- so the two have the same vertex global ids. */
+  if (ens->domain.rank != 0)
+  {
+    MFTL_Object *empty = MFTLObjectCreate(ens->n_bodies_global);
+    MFTLEnsembleAddObject(ens, empty);
+    MFTLObjectBuildDerived(empty);
+    return;
+  }
+  MFTL_Ensemble *tmp_ens = make_ensemble(MPI_COMM_SELF, MFTL_FALSE);
+  MFTL_Object *tmp = MFTLObjectCreate(0);
+  MFTLEnsembleAddObject(tmp_ens, tmp);
+  double origin[3] = {0.0, 0.0, 0.0};
+  MFTLGenerateSphere(tmp, origin, 1.0, refine);
+
+  const int nv = tmp->verts.n, nt = tmp->tris.n;
+  double *pos = malloc((size_t) nv * 3 * sizeof(double));
+  int *tri = malloc((size_t) nt * 3 * sizeof(int));
+  int *map = malloc((size_t) nv * sizeof(int));
+  for (int v = 0; v < nv; ++v) map[v] = -1;
+
+  int kt = 0, kv = 0;
+  for (int t = 0; t < nt; ++t)
+  {
+    int w[3];
+    MFTLGetTriangleVertices(tmp, t, w);
+    if (cap)
+    {
+      double zc = 0.0;
+      for (int k = 0; k < 3; ++k) zc += MFTLVertexPos(tmp, w[k])[2];
+      if (zc < 0.0) continue;
+    }
+    for (int k = 0; k < 3; ++k)
+    {
+      if (map[w[k]] < 0)
+      {
+        const double *p = MFTLVertexPos(tmp, w[k]);
+        pos[3 * kv + 0] = cx + a * p[0];
+        pos[3 * kv + 1] = cy + b * p[1];
+        pos[3 * kv + 2] = cz + c * p[2];
+        map[w[k]] = kv++;
+      }
+      tri[3 * kt + k] = map[w[k]];
+    }
+    kt++;
+  }
+
+  MFTL_Object *obj = MFTLObjectCreate(ens->n_bodies_global);
+  MFTLEnsembleAddObject(ens, obj);
+  MFTLBuildIndexedMesh(obj, pos, kv, tri, kt);
+  MFTLComputeTriangleGeometry(obj, obj->tris.n);
+
+  free(pos);
+  free(tri);
+  free(map);
+  MFTLEnsembleDestroy(&tmp_ens);
+}
+
+static int partition(MFTL_Ensemble *ens)
+{
+  MFTLPublishGeneratedBodies(ens);
+  for (int o = 0; o < ens->n_local_objects; ++o) MFTLComputeTriangleGeometry(ens->local_objects[o], ens->local_objects[o]->tris.n);
+  if (MFTLRedistribute(ens) != MFTL_SUCCESS) return 0;
+  for (int o = 0; o < ens->n_local_objects; ++o) MFTLComputeTriangleGeometry(ens->local_objects[o], ens->local_objects[o]->tris.n);
+  return 1;
+}
+
+static int ensemble_is_sound(const MFTL_Ensemble *ens)
+{
+  if (!inv_local_directory_is_sound(ens)) return 0;
+  for (int o = 0; o < ens->n_local_objects; ++o)
+    if (!inv_partition_is_sound(ens->local_objects[o], g_rank)) return 0;
+  return 1;
+}
+
+static void curvature_params(MFTL_RemeshParameters *p, double lmax)
+{
+  MFTLInitRemeshParams(p, MFTL_REMESH_ISOTROPIC, lmax, 4, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+  p->smooth_iterations = 3;
+  p->smooth_relaxation = 0.5;
+  MFTLRemeshUseCurvatureSizing(p, 0.01 * lmax, 0.3 * lmax, lmax);
+}
+
+static void aniso_params(MFTL_RemeshParameters *p, double l)
+{
+  MFTLInitRemeshParams(p, MFTL_REMESH_ISOTROPIC, l, 4, MFTL_SMOOTH_TRIANGLE_BASED, 180.0);
+  p->smooth_iterations = 3;
+  p->smooth_relaxation = 0.5;
+  MFTLRemeshUseAnisotropicSizing(p, l);
+}
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ * Measurements
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+/** @brief The undirected edge at @p h is counted by exactly one rank. */
+static int counts_this_edge(const MFTL_Object *obj, int h)
+{
+  const int t = MFTLHeTriIdx(h);
+  if (t >= obj->tris.n_local) return 0;
+  const int tw = obj->tris.he[h].twin_idx;
+  if (tw == MFTL_ERROR) return 1;
+  const int to = MFTLHeTriIdx(tw);
+  if (to < obj->tris.n_local) return h < tw;
+  return obj->tris.rec[t].global_id < obj->tris.rec[to].global_id;
+}
+
+typedef struct
+{
+  double n_vertices, n_triangles, n_edges, n_boundary;
+  double volume;  ///< Of a closed body about its own centre (the fixtures are not periodic).
+  double tip_sum, tip_n, waist_sum, waist_n;  ///< Edge lengths with |x - cx| above / below fractions of a.
+} measure_t;
+
+/** @brief Global counts, the enclosed volume and the edge lengths at the tips and the waist of an x-elongated body at @p cx. */
+static void measure(const MFTL_Ensemble *ens, double cx, double a, measure_t *m)
+{
+  double s[10] = {0};
+  for (int o = 0; o < ens->n_local_objects; ++o)
+  {
+    const MFTL_Object *obj = ens->local_objects[o];
+    s[0] += obj->verts.n_local;
+    s[1] += obj->tris.n_local;
+    for (int h = 0; h < 3 * obj->tris.n; ++h)
+    {
+      if (!counts_this_edge(obj, h)) continue;
+      s[2] += 1.0;
+      if (obj->tris.he[h].twin_idx == MFTL_ERROR) s[3] += 1.0;
+      const double *p = MFTLVertexPos(obj, MFTLHeOrigin(obj, h)), *q = MFTLVertexPos(obj, MFTLHeTarget(obj, h));
+      const double x = fabs(0.5 * (p[0] + q[0]) - cx) / a;
+      const double len = MFTLGetEdgeLength(obj, h);
+      if (x > 0.85) s[6] += len, s[7] += 1.0;
+      if (x < 0.2) s[8] += len, s[9] += 1.0;
+    }
+    for (int t = 0; t < obj->tris.n_local; ++t)
+    {
+      int v[3];
+      MFTLGetTriangleVertices(obj, t, v);
+      const double *A = MFTLVertexPos(obj, v[0]), *B = MFTLVertexPos(obj, v[1]), *C = MFTLVertexPos(obj, v[2]);
+      s[4] += (A[0] * (B[1] * C[2] - B[2] * C[1]) - A[1] * (B[0] * C[2] - B[2] * C[0]) + A[2] * (B[0] * C[1] - B[1] * C[0])) / 6.0;
+    }
+  }
+  MPI_Allreduce(MPI_IN_PLACE, s, 10, MPI_DOUBLE, MPI_SUM, MPI_COMM_WORLD);
+  m->n_vertices = s[0];
+  m->n_triangles = s[1];
+  m->n_edges = s[2];
+  m->n_boundary = s[3];
+  m->volume = s[4];
+  m->tip_sum = s[6];
+  m->tip_n = s[7];
+  m->waist_sum = s[8];
+  m->waist_n = s[9];
+}
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ * 1. The sizing field on ghost copies
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+/**
+ * @brief Every copy of every vertex holds the target the unpartitioned mesh
+ *        gives it -- after MFTLRemeshEnsemblePrepareSizing(), and NOT after the
+ *        local half alone (the non-vacuity measure: the exchange is doing
+ *        something).
+ *
+ * The reference is the same body built and sized on each rank alone, matched by
+ * vertex global id (both are built by the same generator, and a redistribution
+ * keeps ids). The tolerance is relative 1e-12, not equality: a one-ring sum is
+ * the same set of terms on both sides but accumulated in a different triangle
+ * order. The open cap exercises the second exchange: its rim vertices average
+ * their interior neighbours, which near a cut plane are ghosts.
+ */
+static int ghost_case(bool cap)
+{
+  MFTL_RemeshParameters p;
+  curvature_params(&p, 0.1);
+
+  /* Reference: the whole body on this rank. */
+  MFTL_Ensemble *ref_ens = make_ensemble(MPI_COMM_SELF, MFTL_FALSE);
+  add_ellipsoid(ref_ens, 0.0, 0.0, 0.0, 0.7, 0.35, 0.35, 3, cap);
+  MFTL_Object *ref = ref_ens->local_objects[0];
+  TEST_ASSERT(agreed(MFTLRemeshPrepareSizing(ref, &p) == MFTL_SUCCESS, MPI_COMM_WORLD));
+  const int n_ref = ref->next_vertex_gid;
+  double *L_ref = malloc((size_t) n_ref * sizeof(double));
+  for (int v = 0; v < ref->verts.n; ++v) L_ref[ref->verts.rec[v].global_id] = ref->verts.sizing[v];
+
+  MFTL_Ensemble *ens = make_ensemble(MPI_COMM_WORLD, MFTL_FALSE);
+  add_ellipsoid(ens, 0.0, 0.0, 0.0, 0.7, 0.35, 0.35, 3, cap);
+  TEST_ASSERT(agreed(partition(ens), MPI_COMM_WORLD));
+
+  /* The local half: owned vertices right, ghosts at the halo rim wrong. */
+  int wrong_local = 0, sized_cross = 0;
+  for (int o = 0; o < ens->n_local_objects; ++o)
+  {
+    MFTL_Object *obj = ens->local_objects[o];
+    MFTLRemeshPrepareSizing(obj, &p);
+    for (int v = obj->verts.n_local; v < obj->verts.n; ++v)
+    {
+      const double r = L_ref[obj->verts.rec[v].global_id];
+      if (fabs(obj->verts.sizing[v] - r) > 1e-9 * r) wrong_local++;
+    }
+  }
+
+  TEST_ASSERT(agreed(MFTLRemeshEnsemblePrepareSizing(ens, &p) == MFTL_SUCCESS, MPI_COMM_WORLD));
+
+  int bad = 0, n_checked = 0;
+  for (int o = 0; o < ens->n_local_objects; ++o)
+  {
+    const MFTL_Object *obj = ens->local_objects[o];
+    for (int v = 0; v < obj->verts.n; ++v)
+    {
+      const double r = L_ref[obj->verts.rec[v].global_id];
+      if (!(fabs(obj->verts.sizing[v] - r) <= 1e-12 * r)) bad++;
+      n_checked++;
+    }
+    /* A cut edge whose end is sized below the coarsest target: the curved part
+     * of the body really is shared between ranks. */
+    for (int t = 0; t < obj->tris.n_local; ++t)
+      for (int k = 0; k < 3; ++k)
+      {
+        const int tw = obj->tris.he[3 * t + k].twin_idx;
+        if (tw == MFTL_ERROR || MFTLHeTriIdx(tw) < obj->tris.n_local) continue;
+        if (obj->verts.sizing[MFTLHeTarget(obj, 3 * t + k)] < 0.95 * p.target_length) sized_cross++;
+      }
+  }
+
+  TEST_ASSERT(agreed(bad == 0, MPI_COMM_WORLD));
+  if (g_nproc > 1)
+  {
+    TEST_ASSERT(anywhere(wrong_local > 0, MPI_COMM_WORLD));
+    TEST_ASSERT(anywhere(sized_cross > 0, MPI_COMM_WORLD));
+  }
+  int g[3] = {wrong_local, sized_cross, n_checked};
+  MPI_Allreduce(MPI_IN_PLACE, g, 3, MPI_INT, MPI_SUM, MPI_COMM_WORLD);
+  if (g_rank == 0)
+    printf("\n    np=%d %s: %d vertex copies checked; %d ghosts wrong before the exchange; %d sized cut edges", g_nproc, cap ? "cap" : "closed", g[2],
+           g[0], g[1]);
+
+  free(L_ref);
+  MFTLEnsembleDestroy(&ens);
+  MFTLEnsembleDestroy(&ref_ens);
+  return 0;
+}
+
+static int test_every_ghost_holds_its_owners_target(void) { return ghost_case(MFTL_FALSE); }
+static int test_rim_targets_average_their_neighbours_across_ranks(void) { return ghost_case(MFTL_TRUE); }
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ * 2. The spanning driver under both modes, against one rank
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+/**
+ * @brief An elongated ellipsoid across every cut plane, remeshed by the spanning
+ *        driver, and the same body remeshed by MFTLRemeshObject() on one rank.
+ *
+ * Asserted: a sound partition, Euler 2, the convergence certificate, volume
+ * held, and the RESULT of the sizing -- the triangle count, and under curvature
+ * sizing the tip-to-waist edge-length ratio -- within a few per cent of the
+ * serial answer. Split and collapse are order-dependent, so the two runs land on
+ * different triangulations of the same surface and equality would be wrong
+ * (cf. test_the_two_strategies_reach_the_same_mesh).
+ */
+static int spanning_case(MFTL_RemeshSizing mode)
+{
+  const double a = 0.7, b = 0.3;
+  MFTL_RemeshParameters p;
+  if (mode == MFTL_REMESH_SIZING_CURVATURE)
+    curvature_params(&p, 0.08);
+  else
+    aniso_params(&p, 0.05);
+  p.parallel_strategy = MFTL_REMESH_PARALLEL_SPANNING;
+
+  /* One rank, the reference -- remeshed to its FIXED POINT, not once. The
+   * curvature field is recomputed by every call (and by every phase of the
+   * spanning driver) from the mesh as it then is, and the first call reads it
+   * off the coarse input, which underestimates the curvature at the tips; a
+   * phased pass sees finer meshes and grades more strongly. Both settle on the
+   * same self-consistent field, which is where a timestep loop lives. */
+  MFTL_Ensemble *ref_ens = make_ensemble(MPI_COMM_SELF, MFTL_FALSE);
+  add_ellipsoid(ref_ens, 0.0, 0.0, 0.0, a, b, b, 3, MFTL_FALSE);
+  MFTL_RemeshStats rs;
+  int calls = 0;
+  do
+  {
+    TEST_ASSERT(agreed(MFTLRemeshObject(ref_ens->local_objects[0], &p, &rs) == MFTL_SUCCESS, MPI_COMM_WORLD));
+  } while (++calls < 12 && rs.n_split + rs.n_collapse + rs.n_flip > 0);
+  const MFTL_Object *ref = ref_ens->local_objects[0];
+  double ref_tip = 0, ref_tn = 0, ref_waist = 0, ref_wn = 0;
+  for (int h = 0; h < 3 * ref->tris.n; ++h)
+  {
+    if (ref->tris.he[h].twin_idx < h) continue;
+    const double *P = MFTLVertexPos(ref, MFTLHeOrigin(ref, h)), *Q = MFTLVertexPos(ref, MFTLHeTarget(ref, h));
+    const double x = fabs(0.5 * (P[0] + Q[0])) / a;
+    if (x > 0.85) ref_tip += MFTLGetEdgeLength(ref, h), ref_tn += 1.0;
+    if (x < 0.2) ref_waist += MFTLGetEdgeLength(ref, h), ref_wn += 1.0;
+  }
+  const double ref_ratio = (ref_tip / ref_tn) / (ref_waist / ref_wn);
+  const double ref_tris = ref->tris.n;
+
+  /* Distributed. */
+  MFTL_Ensemble *ens = make_ensemble(MPI_COMM_WORLD, MFTL_FALSE);
+  add_ellipsoid(ens, 0.0, 0.0, 0.0, a, b, b, 3, MFTL_FALSE);
+  TEST_ASSERT(agreed(partition(ens), MPI_COMM_WORLD));
+  measure_t before, after;
+  measure(ens, 0.0, a, &before);
+
+  int cut = 0;
+  for (int o = 0; o < ens->n_local_objects; ++o) cut += ens->local_objects[o]->tris.n - ens->local_objects[o]->tris.n_local;
+  if (g_nproc > 1) TEST_ASSERT(anywhere(cut > 0, MPI_COMM_WORLD));
+
+  /* To its fixed point as well: the operation counts are rank-local, so the
+   * stopping test is their reduced sum, which every rank sees alike. */
+  MFTL_RemeshStats st;
+  int d_calls = 0;
+  for (;;)
+  {
+    TEST_ASSERT(agreed(MFTLRemeshEnsemble(ens, &p, &st) == MFTL_SUCCESS, MPI_COMM_WORLD));
+    TEST_ASSERT(agreed(st.converged, MPI_COMM_WORLD));
+    int ops = st.n_split + st.n_collapse + st.n_flip;
+    MPI_Allreduce(MPI_IN_PLACE, &ops, 1, MPI_INT, MPI_SUM, MPI_COMM_WORLD);
+    if (++d_calls >= 12 || ops == 0) break;
+  }
+  TEST_ASSERT(agreed(ensemble_is_sound(ens), MPI_COMM_WORLD));
+  measure(ens, 0.0, a, &after);
+
+  const double chi = after.n_vertices - after.n_edges + after.n_triangles;
+  const double ratio = (after.tip_sum / after.tip_n) / (after.waist_sum / after.waist_n);
+  const double dn = fabs(after.n_triangles - ref_tris) / ref_tris;
+  if (g_rank == 0)
+    printf("\n    np=%d %s: %.0f -> %.0f tris after %d calls (one rank %.0f after %d, %.1f%%), tip/waist %.3f (one rank %.3f), last pass %d phases, dV %.2f%%",
+           g_nproc, mode == MFTL_REMESH_SIZING_CURVATURE ? "curvature" : "anisotropic", before.n_triangles, after.n_triangles, d_calls, ref_tris, calls,
+           100.0 * dn,
+           ratio, ref_ratio, st.n_phases, 100.0 * (after.volume / before.volume - 1.0));
+
+  TEST_ASSERT(agreed(fabs(chi - 2.0) < 0.5, MPI_COMM_WORLD));
+  /* Curvature: +1.3 / 3.9 / 6.0 / 4.0 % over the one-rank fixed point at
+   * np = 2 / 4 / 8 / 27 -- bounded, not growing. A redistribution does not
+   * carry the field, so the spanning driver recomputes it after every migration
+   * (up to 18 times in the first pass at np = 8) on a mesh that is part
+   * remeshed, and each recomputation is a chance to split at a dip that the
+   * hysteresis of the band then keeps. Anisotropic: 0 - 1.9 %. */
+  TEST_ASSERT(agreed(dn < (mode == MFTL_REMESH_SIZING_CURVATURE ? 0.08 : 0.05), MPI_COMM_WORLD));
+  TEST_ASSERT(agreed(fabs(after.volume / before.volume - 1.0) < 0.02, MPI_COMM_WORLD));
+  if (mode == MFTL_REMESH_SIZING_CURVATURE) TEST_ASSERT(agreed(fabs(ratio - ref_ratio) < 0.08 * ref_ratio, MPI_COMM_WORLD));
+
+  MFTLEnsembleDestroy(&ens);
+  MFTLEnsembleDestroy(&ref_ens);
+  return 0;
+}
+
+static int test_the_spanning_driver_under_curvature_sizing(void) { return spanning_case(MFTL_REMESH_SIZING_CURVATURE); }
+static int test_the_spanning_driver_under_anisotropic_sizing(void) { return spanning_case(MFTL_REMESH_SIZING_ANISOTROPIC); }
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ * 3. The two strategies, each other's cross-check
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+/**
+ * @brief Four elongated droplets, each on a cut plane, remeshed by the
+ *        dispersed and by the spanning driver. The two share no code past the
+ *        kernel; agreement within 4 % in triangles and 1 % in volume is the
+ *        tolerance of the uniform cross-check, for the same reason.
+ */
+static int strategies_case(MFTL_RemeshSizing mode)
+{
+  MFTL_RemeshParameters p;
+  if (mode == MFTL_REMESH_SIZING_CURVATURE)
+    curvature_params(&p, 0.04);
+  else
+    aniso_params(&p, 0.025);
+
+  measure_t result[2];
+  for (int which = 0; which < 2; ++which)
+  {
+    MFTL_Ensemble *ens = make_ensemble(MPI_COMM_WORLD, MFTL_TRUE);
+    add_ellipsoid(ens, 0.00, 0.00, 0.00, 0.16, 0.08, 0.08, 2, MFTL_FALSE);
+    add_ellipsoid(ens, 0.00, 0.50, 0.50, 0.08, 0.14, 0.08, 2, MFTL_FALSE);
+    add_ellipsoid(ens, -0.50, 0.00, 0.50, 0.08, 0.08, 0.13, 2, MFTL_FALSE);
+    add_ellipsoid(ens, 0.50, 0.50, 0.00, 0.12, 0.07, 0.07, 2, MFTL_FALSE);
+    TEST_ASSERT(agreed(partition(ens), MPI_COMM_WORLD));
+
+    MFTL_RemeshStats st;
+    const int rc = (which == 0) ? MFTLRemeshEnsembleDispersed(ens, &p, &st) : MFTLRemeshEnsembleParallel(ens, &p, &st);
+    TEST_ASSERT(agreed(rc == MFTL_SUCCESS, MPI_COMM_WORLD));
+    TEST_ASSERT(agreed(st.converged, MPI_COMM_WORLD));
+    TEST_ASSERT(agreed(ensemble_is_sound(ens), MPI_COMM_WORLD));
+    /* Not periodic-safe in general, but every droplet sits inside the box. */
+    measure(ens, 0.0, 1.0, &result[which]);
+    MFTLEnsembleDestroy(&ens);
+  }
+  const double dn = fabs(result[0].n_triangles - result[1].n_triangles) / result[1].n_triangles;
+  const double dv = fabs(result[0].volume - result[1].volume) / fabs(result[1].volume);
+  if (g_rank == 0)
+    printf("\n    np=%d %s: dispersed %.0f / spanning %.0f tris (%.1f%%), volume %.1e", g_nproc,
+           mode == MFTL_REMESH_SIZING_CURVATURE ? "curvature" : "anisotropic",
+           result[0].n_triangles, result[1].n_triangles, 100.0 * dn, dv);
+  TEST_ASSERT(agreed(dn < 0.04, MPI_COMM_WORLD));
+  TEST_ASSERT(agreed(dv < 0.01, MPI_COMM_WORLD));
+  return 0;
+}
+
+static int test_the_two_strategies_agree_under_curvature_sizing(void) { return strategies_case(MFTL_REMESH_SIZING_CURVATURE); }
+static int test_the_two_strategies_agree_under_anisotropic_sizing(void) { return strategies_case(MFTL_REMESH_SIZING_ANISOTROPIC); }
+
+/**
+ * @brief A block valid on some ranks and not on others is refused on every
+ *        rank, before anything is touched.
+ */
+static int test_an_invalid_sizing_is_refused_on_every_rank(void)
+{
+  MFTL_Ensemble *ens = make_ensemble(MPI_COMM_WORLD, MFTL_FALSE);
+  add_ellipsoid(ens, 0.0, 0.0, 0.0, 0.5, 0.5, 0.5, 2, MFTL_FALSE);
+  TEST_ASSERT(agreed(partition(ens), MPI_COMM_WORLD));
+  MFTL_RemeshParameters p;
+  curvature_params(&p, 0.1);
+  if (g_rank == g_nproc - 1) p.curvature_tolerance = 0.0;
+  MFTL_RemeshStats st;
+  TEST_ASSERT(agreed(MFTLRemeshEnsemble(ens, &p, &st) == MFTL_ERROR, MPI_COMM_WORLD));
+  TEST_ASSERT(agreed(ensemble_is_sound(ens), MPI_COMM_WORLD));
+  MFTLEnsembleDestroy(&ens);
+  return 0;
+}
+
+int main(int argc, char **argv)
+{
+  MPI_Init(&argc, &argv);
+  MPI_Comm_rank(MPI_COMM_WORLD, &g_rank);
+  MPI_Comm_size(MPI_COMM_WORLD, &g_nproc);
+  MFTLRegisterMpiTypes();
+
+  if (g_rank == 0) printf("\n=== Sizing on a partitioned mesh (np = %d) ===\n", g_nproc);
+  RUN_TEST(test_every_ghost_holds_its_owners_target);
+  RUN_TEST(test_rim_targets_average_their_neighbours_across_ranks);
+  RUN_TEST(test_the_spanning_driver_under_curvature_sizing);
+  RUN_TEST(test_the_spanning_driver_under_anisotropic_sizing);
+  RUN_TEST(test_the_two_strategies_agree_under_curvature_sizing);
+  RUN_TEST(test_the_two_strategies_agree_under_anisotropic_sizing);
+  RUN_TEST(test_an_invalid_sizing_is_refused_on_every_rank);
+
+  if (g_rank == 0) TEST_REPORT();
+  MFTLFreeMpiTypes();
+  MPI_Finalize();
+  return (g_tests_failed > 0) ? 1 : 0;
+}
