+/* ── EXPERIMENT (archive/volume_budget_experiment.patch) ────────────────────
+ * Switches: MFTL_EXP_VBUDGET=1 per-sweep and per-operation volume budget,
+ * printed at exit (the volume-preserving collapse is the library's
+ * collapse_preserves_volume); MFTL_EXP_FLIPGUARD=tau refuse a flip whose volume change exceeds
+ * tau * A_quad * |edge| / 3; MFTL_EXP_FLIPCOMP=1 restore a flip's volume by a
+ * common shift of its four vertices along the quad normal. */
+typedef struct
+{
+  int on, flipcomp;
+  double flipguard;
+  double sweep[4];  // split, collapse, flip, smooth: summed volume change
+  double v_start;  // volume at the first call
+  int have_start;
+  double col_dv[6], flip_dv[6];  // by bin of the local bending angle
+  long long col_n[6], flip_n[6], flip_refused, flip_comp;
+  double comp_max;  // largest |shift| / edge of a compensated flip
+} MFTL_ExpVolume;
+MFTL_ExpVolume *MFTLExpVolume(void);
+double MFTLExpObjectVolume(const MFTL_Object *obj);
+
 #endif  // MFTL_REMESH_INTERNAL_H
