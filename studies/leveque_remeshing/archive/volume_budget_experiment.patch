+/* ── EXPERIMENT (archive/volume_budget_experiment.patch) ──────────────────── */
+
+static void exp_volume_report(void)
+{
+  MFTL_ExpVolume *e = MFTLExpVolume();
+  if (!e->on) return;
+  const double v0 = e->have_start ? e->v_start : 1.0;
+  fprintf(stderr, "EXPVOL sweeps (%% of V0): split %+.5f collapse %+.5f flip %+.5f smooth %+.5f\n", 100.0 * e->sweep[0] / v0, 100.0 * e->sweep[1] / v0,
+          100.0 * e->sweep[2] / v0, 100.0 * e->sweep[3] / v0);
+  static const char *bins[6] = {"<5", "5-10", "10-20", "20-40", "40-80", ">80"};
+  for (int i = 0; i < 6; ++i)
+    fprintf(stderr, "EXPVOL bin %-6s collapses %9lld dV %+.5f %%   flips %9lld dV %+.5f %%\n", bins[i], e->col_n[i], 100.0 * e->col_dv[i] / v0, e->flip_n[i],
+            100.0 * e->flip_dv[i] / v0);
+  fprintf(stderr, "EXPVOL flips refused by the guard %lld, compensated %lld (largest shift %.3e of an edge)\n", e->flip_refused, e->flip_comp, e->comp_max);
+}
+
+MFTL_ExpVolume *MFTLExpVolume(void)
+{
+  static MFTL_ExpVolume e;
+  static int init = 0;
+  if (!init)
+  {
+    init = 1;
+    memset(&e, 0, sizeof(e));
+    e.on = getenv("MFTL_EXP_VBUDGET") != MFTL_NULL;
+    e.flipcomp = getenv("MFTL_EXP_FLIPCOMP") != MFTL_NULL;
+    e.flipguard = getenv("MFTL_EXP_FLIPGUARD") ? atof(getenv("MFTL_EXP_FLIPGUARD")) : 0.0;
+    if (e.on) atexit(exp_volume_report);
+  }
+  return &e;
+}
+
+/* Six times the signed tetrahedron volume of (o, x, y, z). */
+static inline double exp_det(const double *o, const double *x, const double *y, const double *z)
+{
+  const double u[3] = {x[0] - o[0], x[1] - o[1], x[2] - o[2]}, v[3] = {y[0] - o[0], y[1] - o[1], y[2] - o[2]},
+               w[3] = {z[0] - o[0], z[1] - o[1], z[2] - o[2]};
+  return u[0] * (v[1] * w[2] - v[2] * w[1]) - u[1] * (v[0] * w[2] - v[2] * w[0]) + u[2] * (v[0] * w[1] - v[1] * w[0]);
+}
+
+double MFTLExpObjectVolume(const MFTL_Object *obj)
+{
+  if (obj->tris.n_local == 0) return 0.0;
+  double T[3][3], o[3];
+  MFTLGetTriangleCorners(obj, 0, T);
+  for (int k = 0; k < 3; ++k) o[k] = T[0][k];
+  double v = 0.0;
+  for (int t = 0; t < obj->tris.n_local; ++t)
+  {
+    if (obj->tris.rec[t].flags & MFTL_FLAG_DEAD) continue;
+    MFTLGetTriangleCorners(obj, t, T);
+    v += exp_det(o, T[0], T[1], T[2]);
+  }
+  return v / 6.0;
+}
+
+static int exp_bin(double deg) { return deg < 5 ? 0 : deg < 10 ? 1 : deg < 20 ? 2 : deg < 40 ? 3 : deg < 80 ? 4 : 5; }
+
+/* Corners of t relative to o (minimum image), a and b replaced by p when p != NULL. */
+static void exp_corners(const MFTL_Object *obj, int t, int a, int b, const double *p, const double *o, double X[3][3])
+{
+  int v[3];
+  MFTLGetTriangleVertices(obj, t, v);
+  for (int k = 0; k < 3; ++k)
+  {
+    const double *x = (p && (v[k] == a || v[k] == b)) ? p : MFTLVertexPos(obj, v[k]);
+    MFTLGetMinimumImageVector(obj->domain, X[k], o, x);
+  }
+}
+
+/* The exact volume change of collapsing a, b into p, its gradient in p, and the
+ * patch's largest angle between a triangle normal and the patch normal. */
+static int exp_collapse_volume(const MFTL_Object *obj, int a, int b, const double p[3], double *dv, double grad[3], double *bend_deg)
+{
+  int fa[MFTL_REMESH_RING_MAX], fb[MFTL_REMESH_RING_MAX];
+  const int na = ring_triangles(obj, a, fa), nb = ring_triangles(obj, b, fb);
+  if (na == MFTL_ERROR || nb == MFTL_ERROR) return MFTL_ERROR;
+  const double zero[3] = {0.0, 0.0, 0.0};
+  double sum = 0.0, S[3] = {0.0, 0.0, 0.0}, nsum[3] = {0.0, 0.0, 0.0};
+  double nt[2 * MFTL_REMESH_RING_MAX][3];
+  int m = 0;
+  grad[0] = grad[1] = grad[2] = 0.0;
+  for (int pass = 0; pass < 2; ++pass)
+  {
+    const int *f = pass ? fb : fa;
+    const int n = pass ? nb : na;
+    for (int i = 0; i < n; ++i)
+    {
+      const int t = f[i];
+      int v[3];
+      MFTLGetTriangleVertices(obj, t, v);
+      const bool has_a = v[0] == a || v[1] == a || v[2] == a, has_b = v[0] == b || v[1] == b || v[2] == b;
+      if (pass == 1 && has_a) continue;  // counted in pass 0
+      double X[3][3];
+      exp_corners(obj, t, a, b, MFTL_NULL, p, X);
+      const double old = exp_det(zero, X[0], X[1], X[2]);
+      double e1[3], e2[3], c[3];
+      for (int k = 0; k < 3; ++k)
+      {
+        e1[k] = X[1][k] - X[0][k];
+        e2[k] = X[2][k] - X[0][k];
+      }
+      c[0] = e1[1] * e2[2] - e1[2] * e2[1];
+      c[1] = e1[2] * e2[0] - e1[0] * e2[2];
+      c[2] = e1[0] * e2[1] - e1[1] * e2[0];
+      for (int k = 0; k < 3; ++k) nsum[k] += c[k];
+      if (m < 2 * MFTL_REMESH_RING_MAX) memcpy(nt[m++], c, sizeof(c));
+      if (has_a && has_b)
+      {
+        sum -= old;  // removed by the collapse
+        continue;
+      }
+      /* With the moved corner at the origin p the new determinant is zero; the
+       * gradient in p is the cross product of the other two, in cyclic order. */
+      int k0 = 0;
+      for (int k = 0; k < 3; ++k)
+        if (v[k] == a || v[k] == b) k0 = k;
+      const double *y = X[(k0 + 1) % 3], *z = X[(k0 + 2) % 3];
+      const double g[3] = {y[1] * z[2] - y[2] * z[1], y[2] * z[0] - y[0] * z[2], y[0] * z[1] - y[1] * z[0]};
+      for (int k = 0; k < 3; ++k) S[k] += g[k];
+      sum -= old;  // new determinant with p at the origin is 0
+    }
+  }
+  *dv = sum / 6.0;
+  for (int k = 0; k < 3; ++k) grad[k] = S[k] / 6.0;
+  double worst = 1.0;
+  const double ln = sqrt(nsum[0] * nsum[0] + nsum[1] * nsum[1] + nsum[2] * nsum[2]);
+  for (int i = 0; i < m && ln > 0.0; ++i)
+  {
+    const double l = sqrt(nt[i][0] * nt[i][0] + nt[i][1] * nt[i][1] + nt[i][2] * nt[i][2]);
+    if (l > 0.0) worst = fmin(worst, (nt[i][0] * nsum[0] + nt[i][1] * nsum[1] + nt[i][2] * nsum[2]) / (l * ln));
+  }
+  *bend_deg = acos(fmax(-1.0, fmin(1.0, worst))) * 180.0 / MFTL_PI;
+  return MFTL_SUCCESS;
+}
+
+/* The exact volume change of flipping the quad (a,b,c),(b,a,d) to (a,d,c),(d,b,c). */
+static double exp_flip_volume(const MFTL_Object *obj, int va, int vb, int vc, int vd)
+{
+  const double *o = MFTLVertexPos(obj, va);
+  double B[3], C[3], D[3];
+  const double A[3] = {0.0, 0.0, 0.0};
+  MFTLGetMinimumImageVector(obj->domain, B, o, MFTLVertexPos(obj, vb));
+  MFTLGetMinimumImageVector(obj->domain, C, o, MFTLVertexPos(obj, vc));
+  MFTLGetMinimumImageVector(obj->domain, D, o, MFTLVertexPos(obj, vd));
+  const double z[3] = {0.0, 0.0, 0.0};
+  (void) z;
+  /* relative to A: det(A..) terms with A = 0 vanish */
+  const double neu = exp_det(A, A, D, C) + exp_det(A, D, B, C);
+  const double alt = exp_det(A, A, B, C) + exp_det(A, B, A, D);
+  return (neu - alt) / 6.0;
+}
