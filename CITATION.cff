version: 2.0.0-alpha.1
date-released: 2026-11-13
license: Apache-2.0
repository-code: "https://github.com/Chris-Gorges/MFTL2"
keywords:
  - front tracking
  - surface mesh
  - remeshing
  - computational geometry
  - MPI
  - HPC
  - multiphase flow
  - immersed boundary method
